1.Найти все книги конкретного автора (например, Пушкина)
MATCH (a:Автор {имя: 'Александр Пушкин'})-[:НАПИСАЛ]->(k:Книга)
RETURN k.название, k.год_издания;
2. Найти все книги определенного жанра (например, Роман)
MATCH (k:Книга)-[:ПРИНАДЛЕЖИТ_К_ЖАНРУ]->(g:Жанр {название: 'Роман'})
RETURN k.название, k.количество_страниц ORDER BY k.количество_страниц DESC;
3. Найти всех авторов, которые писали в жанре "Поэзия"
MATCH (a:Автор)-[:НАПИСАЛ]->(k:Книга)-[:ПРИНАДЛЕЖИТ_К_ЖАНРУ]->(g:Жанр {название: 'Поэзия'})
RETURN DISTINCT a.имя;
4. Подсчитать количество книг каждого автора
MATCH (a:Автор)-[:НАПИСАЛ]->(k:Книга)
RETURN a.имя, count(k) AS количество_книг ORDER BY количество_книг DESC;
5. Найти книги, изданные в издательстве "Эксмо"
MATCH (k:Книга)-[:ИЗДАН_В]->(p:Издательство {название: 'Эксмо'})
RETURN k.название;
6. Найти самую объемную книгу (по количеству страниц)
MATCH (k:Книга)
RETURN k.название, k.количество_страниц
ORDER BY k.количество_страниц DESC
LIMIT 1;
7. Найти авторов, чьи книги были изданы в Москве
MATCH (a:Автор)-[:НАПИСАЛ]->(k:Книга)-[:ИЗДАН_В]->(p:Издательство)
WHERE p.адрес = 'Москва'
RETURN DISTINCT a.имя, p.название;
8. Найти книги, написанные в XX веке (после 1900 года)
MATCH (k:Книга)
WHERE k.год_издания >= 1900 AND k.год_издания < 2000
RETURN k.название, k.год_издания
ORDER BY k.год_издания;
9. Найти среднее количество страниц в книгах каждого жанра
MATCH (k:Книга)-[:ПРИНАДЛЕЖИТ_К_ЖАНРУ]->(g:Жанр)
RETURN g.название, avg(k.количество_страниц) AS среднее_страниц
ORDER BY среднее_страниц DESC;
10. Найти "коллег" по жанру (авторов, которые пишут в одном жанре)
MATCH (a1:Автор)-[:НАПИСАЛ]->(:Книга)-[:ПРИНАДЛЕЖИТ_К_ЖАНРУ]->(g:Жанр)<-[:ПРИНАДЛЕЖИТ_К_ЖАНРУ]-(:Книга)<-[:НАПИСАЛ]-(a2:Автор)
WHERE a1.имя <> a2.имя
RETURN DISTINCT a1.имя, a2.имя, g.название
LIMIT 10;


